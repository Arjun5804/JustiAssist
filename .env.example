# ==========================================
# JustiAssist v2.0 - Configuration
# ==========================================

# ------------------------------------------
# Environment (Required)
# ------------------------------------------
# Set to 'production' for strict security checks.
APP_ENV=development
APP_NAME="JustiAssist v2.0"
DEBUG=true

# ------------------------------------------
# Security (Required in Production)
# ------------------------------------------
# IMPORTANT: You MUST change JWT_SECRET_KEY in production to a secure random string (>=32 chars).
# In 'development' mode, a default will be used if left blank.
JWT_SECRET_KEY=justiassist-secret-change-in-production-2026
JWT_EXPIRY_HOURS=24

# ------------------------------------------
# Database (Phase 7B will introduce PostgreSQL)
# ------------------------------------------
# Currently uses SQLite.
DATABASE_URL=sqlite:///justiassist.db

# ------------------------------------------
# LLM Providers
# ------------------------------------------
# Groq is the primary intended provider.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama is strictly optional. It will be used as a fallback if configured.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------
# External APIs (Optional depending on usage)
# ------------------------------------------
FIRECRAWL_API_KEY=fc-your-api-key-here
INDIAN_KANOON_API_KEY=your_kanoon_api_key_here

# ------------------------------------------
# CORS / Networking
# ------------------------------------------
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# JustiAssist Environment Configuration Template
# Copy this file to .env and fill in your values.

# ==================== Groq Cloud (Primary LLM) ====================
# Get your key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ==================== Ollama (Local Fallback) ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ==================== Embedding Model ====================
# Options: sentence-transformers/all-MiniLM-L6-v2, BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3

# ==================== External APIs ====================
# Indian Kanoon API key from: https://api.indiankanoon.org
INDIAN_KANOON_API_KEY=your_indian_kanoon_api_key_here

# Firecrawl (Web Search & Extraction) API key from: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ==================== Authentication ====================
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_EXPIRY_HOURS=24

# ==================== Database ====================
DATABASE_URL=sqlite:///justiassist.db

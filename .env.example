# ==========================================
# JustiAssist v2.0 - Configuration
# ==========================================

# ------------------------------------------
# Environment (Required)
# ------------------------------------------
# Set to 'production' for strict security checks.
APP_ENV=development
APP_NAME="JustiAssist v2.0"
DEBUG=true

# ------------------------------------------
# Security (Required in Production)
# ------------------------------------------
# IMPORTANT: You MUST change JWT_SECRET_KEY in production to a secure random string (>=32 chars).
# In 'development' mode, a default will be used if left blank.
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_EXPIRY_HOURS=24

# ------------------------------------------
# Database (Phase 7B introduced PostgreSQL/SQLite choice)
# ------------------------------------------
DATABASE_URL=sqlite:///justiassist.db

# ------------------------------------------
# Storage (Phase 7D Document Storage)
# ------------------------------------------
# Set STORAGE_PROVIDER to 'local' for filesystem or 's3' for object storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.data/storage
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_BUCKET=your_bucket_name
# S3_REGION=us-east-1

# ------------------------------------------
# LLM Providers
# ------------------------------------------
# Groq is the primary intended provider.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama is strictly optional. It will be used as a fallback if configured.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------
# External APIs (Optional depending on usage)
# ------------------------------------------
FIRECRAWL_API_KEY=fc-your-api-key-here
INDIAN_KANOON_API_KEY=your_kanoon_api_key_here

# ------------------------------------------
# CORS / Networking
# ------------------------------------------
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
